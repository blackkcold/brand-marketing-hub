{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blackkcold/brand-marketing-hub/schemas/evidence.schema.json",
  "title": "Brand Marketing Hub Evidence Manifest",
  "type": "object",
  "required": [
    "version",
    "claims"
  ],
  "properties": {
    "version": {
      "const": "4.0"
    },
    "generated_at": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "statement",
          "status",
          "source_ids"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-[0-9]{3,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "user-provided",
              "uncertain",
              "rejected"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SRC-[0-9]{3,}$"
            },
            "minItems": 1
          },
          "slide_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]{2,}$"
            }
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^IMG-[0-9]{3,}$"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "source_type",
          "url",
          "retrieved_at"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^SRC-[0-9]{3,}$"
          },
          "title": {
            "type": "string"
          },
          "source_type": {
            "enum": [
              "official",
              "partner-official",
              "authority",
              "academic",
              "major-media",
              "internal",
              "user-provided"
            ]
          },
          "url": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved_at": {
            "type": "string"
          },
          "freshness_checked": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}