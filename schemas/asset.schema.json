{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blackkcold/brand-marketing-hub/schemas/asset.schema.json",
  "title": "Brand Marketing Hub Asset Manifest v4.1",
  "type": "object",
  "required": [
    "version",
    "assets"
  ],
  "properties": {
    "version": {
      "const": "4.1"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "type",
          "verification",
          "semantic_verified",
          "visual_role"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^IMG-[0-9]{3,}$"
          },
          "type": {
            "enum": [
              "official-product-image",
              "official-campaign-image",
              "official-logo",
              "official-kv",
              "licensed-image",
              "authorized-screenshot",
              "generated-concept",
              "chart",
              "diagram",
              "source-extract"
            ]
          },
          "brand": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject_entity": {
            "type": [
              "string",
              "null"
            ]
          },
          "collaboration": {
            "type": [
              "string",
              "null"
            ]
          },
          "product_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "case": {
            "type": [
              "string",
              "null"
            ]
          },
          "visual_role": {
            "enum": [
              "hero",
              "product-proof",
              "collaboration-proof",
              "logo",
              "case-study",
              "context",
              "background",
              "chart",
              "diagram",
              "concept"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(SRC-[0-9]{3,}|UNIT-[0-9]{4,})$"
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "verification": {
            "enum": [
              "verified",
              "user-provided",
              "generated",
              "uncertain"
            ]
          },
          "semantic_verified": {
            "type": "boolean"
          },
          "factual_evidence_allowed": {
            "type": "boolean"
          },
          "embedded_required": {
            "type": "boolean"
          },
          "license_notes": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "visual_role": {
                  "enum": [
                    "product-proof",
                    "collaboration-proof",
                    "case-study",
                    "logo"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "semantic_verified": {
                  "const": true
                },
                "verification": {
                  "enum": [
                    "verified",
                    "user-provided"
                  ]
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "source_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "properties": {
                    "source_url": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "factual_evidence_allowed": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "verification": {
                  "enum": [
                    "verified",
                    "user-provided"
                  ]
                },
                "semantic_verified": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}