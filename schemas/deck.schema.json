{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blackkcold/brand-marketing-hub/schemas/deck.schema.json",
  "title": "Brand Marketing Hub Deck Spec v4.1",
  "type": "object",
  "required": [
    "version",
    "deck",
    "slides"
  ],
  "$defs": {
    "blockBase": {
      "type": "object",
      "required": [
        "block_id",
        "type"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^BLK-[0-9]{3,}$"
        },
        "type": {
          "type": "string"
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^UNIT-[0-9]{4,}$"
          }
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CLM-[0-9]{3,}$"
          }
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^IMG-[0-9]{3,}$"
          }
        },
        "preserve_exact": {
          "type": "boolean"
        }
      }
    },
    "headline": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "properties": {
            "type": {
              "const": "headline"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "body": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "properties": {
            "type": {
              "const": "body_text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "bullets": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "properties": {
            "type": {
              "const": "bullets"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "items"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "stat": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "properties": {
            "type": {
              "const": "stat"
            },
            "value": {},
            "label": {
              "type": "string"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "value",
            "label"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "table": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "properties": {
            "type": {
              "const": "table"
            },
            "headers": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "null"
                ]
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "required": [
            "rows"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "chart": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "properties": {
            "type": {
              "const": "chart"
            },
            "chart_type": {
              "enum": [
                "bar",
                "column",
                "line",
                "area",
                "pie",
                "doughnut",
                "scatter",
                "waterfall",
                "other"
              ]
            },
            "data": {
              "type": "object",
              "required": [
                "labels",
                "series"
              ],
              "properties": {
                "labels": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "integer",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "series": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "values"
                    ],
                    "properties": {
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": [
                            "number",
                            "integer",
                            "null"
                          ]
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "source_range": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "chart_type",
            "data"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "image": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "properties": {
            "type": {
              "const": "image"
            },
            "asset_id": {
              "type": "string",
              "pattern": "^IMG-[0-9]{3,}$"
            },
            "role": {
              "type": "string"
            }
          },
          "required": [
            "asset_id"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "comparison": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "properties": {
            "type": {
              "const": "comparison"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "label": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "time": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "integer",
                      "boolean",
                      "null"
                    ]
                  },
                  "tag": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              }
            }
          },
          "required": [
            "items"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "callout": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "properties": {
            "type": {
              "const": "callout"
            },
            "text": {
              "type": "string"
            },
            "tag": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "text"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "timeline": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "properties": {
            "type": {
              "const": "timeline"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "label": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "time": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "integer",
                      "boolean",
                      "null"
                    ]
                  },
                  "tag": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              }
            }
          },
          "required": [
            "items"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "sourceFooter": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "properties": {
            "type": {
              "const": "source_footer"
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(SRC-[0-9]{3,}|UNIT-[0-9]{4,})$"
              },
              "minItems": 1
            }
          },
          "required": [
            "source_ids"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "properties": {
    "version": {
      "const": "4.1"
    },
    "deck": {
      "type": "object",
      "required": [
        "title",
        "purpose",
        "story_archetype",
        "visual_template",
        "template_manifest",
        "runtime_preference",
        "source_of_truth"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string"
        },
        "decision_question": {
          "type": "string"
        },
        "story_archetype": {
          "enum": [
            "research",
            "strategy",
            "campaign",
            "brand-partnership",
            "business-review",
            "project-update",
            "proposal",
            "custom"
          ]
        },
        "visual_template": {
          "type": "string",
          "minLength": 1
        },
        "template_manifest": {
          "type": "string",
          "minLength": 1
        },
        "runtime_preference": {
          "type": "array",
          "items": {
            "enum": [
              "chatgpt-presentations",
              "powerpoint",
              "artifact-tool",
              "pptxgenjs",
              "legacy-python"
            ]
          },
          "minItems": 1
        },
        "brand_profile": {
          "type": "string"
        },
        "source_of_truth": {
          "const": "deck_spec.json"
        },
        "confidentiality": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        }
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slide_id",
          "intent",
          "takeaway",
          "content",
          "layout_candidates"
        ],
        "properties": {
          "slide_id": {
            "type": "string",
            "pattern": "^S[0-9]{2,}$"
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "takeaway": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string"
          },
          "source_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^UNIT-[0-9]{4,}$"
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CLM-[0-9]{3,}$"
            }
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^IMG-[0-9]{3,}$"
            }
          },
          "content": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/headline"
                },
                {
                  "$ref": "#/$defs/body"
                },
                {
                  "$ref": "#/$defs/bullets"
                },
                {
                  "$ref": "#/$defs/stat"
                },
                {
                  "$ref": "#/$defs/table"
                },
                {
                  "$ref": "#/$defs/chart"
                },
                {
                  "$ref": "#/$defs/image"
                },
                {
                  "$ref": "#/$defs/comparison"
                },
                {
                  "$ref": "#/$defs/callout"
                },
                {
                  "$ref": "#/$defs/timeline"
                },
                {
                  "$ref": "#/$defs/sourceFooter"
                }
              ]
            }
          },
          "layout_candidates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "must_preserve_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^UNIT-[0-9]{4,}$"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}