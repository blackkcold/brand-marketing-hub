{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blackkcold/brand-marketing-hub/schemas/qa.schema.json",
  "title": "Brand Marketing Hub QA Report v4.1",
  "type": "object",
  "required": [
    "version",
    "status",
    "issues",
    "gates"
  ],
  "properties": {
    "version": {
      "const": "4.1"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "pass-with-cosmetic-notes"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "code",
          "message"
        ],
        "properties": {
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "code": {
            "type": "string"
          },
          "slide_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "asset_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "repair_hint": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "object",
      "required": [
        "coverage",
        "semantic",
        "embedded_assets",
        "template_fidelity",
        "structural",
        "geometry",
        "visual"
      ],
      "properties": {
        "coverage": {
          "type": "boolean"
        },
        "semantic": {
          "type": "boolean"
        },
        "embedded_assets": {
          "type": "boolean"
        },
        "template_fidelity": {
          "type": "boolean"
        },
        "structural": {
          "type": "boolean"
        },
        "geometry": {
          "type": "boolean"
        },
        "visual": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "pptx": {
          "type": [
            "string",
            "null"
          ]
        },
        "pdf": {
          "type": [
            "string",
            "null"
          ]
        },
        "slide_png_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "montage": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "coverage_summary": {
      "type": "object"
    },
    "template_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}